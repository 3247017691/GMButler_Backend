<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.itheima.mapper.CourseMapper">
    <select id="getCoursesBySubject" resultType="com.itheima.entity.Course">
        SELECT id, name, subject, price, target, description, create_time, update_time
        FROM course
        <where>
            <if test="subject != null">
                subject = #{subject}
            </if>
        </where>
        ORDER BY id DESC
    </select>
</mapper>